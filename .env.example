# 宿主机 MT4 history 目录（Compose 只读挂载到容器 /data/history）
# Windows 建议用正斜杠: MT4_HISTORY_DIR=C:/Program Files (x86)/MetaTrader 4/history
# 留空/不建 .env 时默认使用仓库自带 data/history
MT4_HISTORY_DIR=./data/history

# 浏览器访问端口（改端口会改变 localStorage 的 origin）
HOST_PORT=8888

# 监听地址：127.0.0.1 仅本机；0.0.0.0 开放局域网（服务无鉴权，谨慎）
BIND_ADDR=127.0.0.1
